PORT=5001
# AutoGoPay API Key dari dashboard autogopay.site (Kosongkan jika ingin mode testing simulasi)
AUTOGOPAY_API_KEY=
AUTOGOPAY_BASE_URL=https://v1-gateway.autogopay.site

# Token Akun ANFU Store Anda (JWT) untuk auto-debit saldo saat ada pesanan masuk
ANFU_TOKEN=
ANFU_BASE_URL=https://api.anfu.web.id/api

# OCTO-CRM Integration (Pemantauan Kontak & Deals Penjualan)
OCTO_CRM_URL=http://localhost:8080
OCTO_CRM_API_KEY=
OCTO_CRM_WORKSPACE_ID=ws-default
